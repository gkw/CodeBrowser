{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gkw/CodeBrowser/blob/main/docs/provider-plugin-manifest.schema.json",
  "title": "Code Browser Provider Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "type", "protocolVersion", "entrypoint"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "type": {
      "const": "provider"
    },
    "protocolVersion": {
      "const": 1
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[^/].*\\.py$"
    },
    "environment": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
      }
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "publisher": {
      "type": "string",
      "maxLength": 100
    },
    "license": {
      "type": "string",
      "maxLength": 80
    },
    "homepage": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  }
}
